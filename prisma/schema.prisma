// prisma/schema.prisma
// Schema para ConectaPeru (DiretorioPeruano)
//
// IMPORTANTE: este schema refleja el estado REAL de la base de datos Neon,
// materializada por los scripts SQL idempotentes:
//   - apply_schema.sql          (schema base: address/contact JSONB, modelo Message)
//   - prisma/migration_manual.sql (columnas de billing/KYC añadidas)
//   - supabase_migration.sql    (archived/deletedAt en Message)
//   - prisma/lgpd_migration.sql (LGPD consent governance tables)
//
// Se usa el modelo JSONB + Message (no B2BConversation/B2BMessage estructurado),
// porque es el que está aplicado y poblado en producción (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String           @id @default(dbgenerated("gen_random_uuid()"))
  clerkId   String?          @unique
  email     String?
  name      String?
  role      String           @default("consumer") // consumer, business, admin, superadmin
  language  String           @default("pt-BR")

  business  BusinessProfile?
  reviews   Review[]
  communityTopics CommunityTopic[] @relation("CommunityTopics")
  communityPosts  CommunityPost[]  @relation("CommunityPosts")
  communityVotes  CommunityVote[]  @relation("CommunityVotes")
  consentRecords  ConsentRecord[]
  cookiePreferences CookiePreference[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model BusinessProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()"))
  name               String?
  description        String?
  category           String   @default("restaurante")

  // Structured as JSONB in Neon (matches the deployed schema)
  address            Json?
  tags               String[]
  photos             String[]
  contact            Json?

  status             String   @default("pending") // pending, approved, rejected, disabled
  rating             Float?   // average rating, maintained from approved reviews

  // Owner (KYC + billing)
  ownerId            String?  @unique
  owner              User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cnpj               String?  @unique
  ownerFullName      String?
  ownerBirthCity     String?
  rejectionReason    String?
  approvedAt         DateTime?
  disabledAt         DateTime?

  // Stripe subscription
  stripeCustomerId   String?  @unique
  subscriptionId     String?
  subscriptionStatus String?  // none, trial, active, past_due, canceled
  trialEndsAt        DateTime?

  // Paid community ads (Opción A+B: sidebar + featured)
  ads                BusinessAd[]

  // Relations
  reviews            Review[]
  sentMessages       Message[] @relation("BusinessSentMessages")
  receivedMessages   Message[] @relation("BusinessReceivedMessages")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([category])
}

model Review {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  rating      Int?
  comment     String?
  status      String          @default("approved") // approved, pending
  business    BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  consumer    User            @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  consumerId  String
  createdAt   DateTime        @default(now())

  @@index([businessId])
  @@index([status])
  @@unique([consumerId, businessId])
}

model Message {
  id              String          @id @default(dbgenerated("gen_random_uuid()"))
  fromBusiness    BusinessProfile @relation("BusinessSentMessages", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  fromBusinessId  String
  toBusiness      BusinessProfile @relation("BusinessReceivedMessages", fields: [toBusinessId], references: [id], onDelete: Cascade)
  toBusinessId    String
  body            String?
  read            Boolean         @default(false)
  archived        Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())

  @@index([fromBusinessId])
  @@index([toBusinessId])
  @@index([read])
}

model SiteConfig {
  id        String   @id @default("singleton")
  betaMode  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([id])
}

// Deduplicated Stripe webhook events for idempotent processing (no Redis).
model WebhookEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  stripeEventId String    @unique
  type          String
  payload       Json?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([type])
}

// ── Community (foro estilo Reddit/Yahoo Answers, alcance básico) ─────────────
// Reglas: lectura pública; participación (crear temas, comentar, votar, reportar)
// solo para usuarios autenticados de cualquier rol (consumer, business, admin,
// superadmin). Moderación post-publicación por superadmin (ocultar/restaurar/
// eliminar) + botón reportar.

model CommunityTopic {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  body        String
  author      User     @relation("CommunityTopics", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  status      String   @default("visible") // visible, hidden, deleted
  reported    Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts CommunityPost[]

  @@index([status])
  @@index([createdAt])
  @@index([authorId])
}

model CommunityPost {
  id        String          @id @default(dbgenerated("gen_random_uuid()"))
  topic     CommunityTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   String
  // TikTok-style tree: parentId references the post being replied to — the UI
  // renders a SINGLE indent level with "@autor" as the reply reference (not
  // infinite nesting).
  parentId  String?
  parent    CommunityPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityPost[] @relation("PostReplies")
  author    User            @relation("CommunityPosts", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  status    String          @default("visible") // visible, hidden, deleted
  reported  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([topicId])
  @@index([parentId])
  @@index([authorId])
  @@index([status])
}

model CommunityVote {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  // targetType: 'topic' | 'post' — votes apply to BOTH topics and replies.
  targetType String
  targetId   String
  user       User     @relation("CommunityVotes", fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  value      Int      // 1 = like, -1 = dislike (toggle en upsert)
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, userId])
  @@index([targetId])
  @@index([userId])
}

// ── Paid community ads (anuncios en Comunidad) ───────────────────────────────
// Opción A (sidebar 300x250) + Opción B (featured card arriba del listado).
// Solo negocios aprobados CON suscripción activa pueden comprar un anuncio.
// Pago: PaymentIntent one-time R$30 por 30 días (stripe-checkout pattern).
model BusinessAd {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  business        BusinessProfile  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  title           String
  imageUrl        String?          // opcional — si falta, usa photos[0] del negocio
  targetUrl       String?          // opcional — si falta, enlaza a /negocio/:id
  status          String           @default("pending") // pending, active, expired, cancelled
  stripePaymentId String?          @unique
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([endsAt])
  @@index([businessId])
}

// ── LGPD consent governance (append-only evidence + cookie preferences) ─────
// Consent evidence rows are NEVER updated: grants and revocations append new
// rows (spec: append-only consent evidence; "No sobrescrever evidencia
// histórica"). Current consent = latest row per key. CookiePreference is
// current UI state (upsert per user), NOT evidence. Table names are the
// Prisma defaults ("ConsentRecord", "CookiePreference") matching the quoted
// camelCase manual SQL in prisma/lgpd_migration.sql (no `prisma migrate`).

model ConsentRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String // terms_of_service | privacy_policy | cookie_policy
  documentVersion String
  documentHash    String
  purpose         String // service | marketing | analytics
  legalBasis      String // contract | consent | legitimate_interest
  intent          String // grant | revoke
  granted         Boolean
  consentedAt     DateTime @default(now())
  revokedAt       DateTime?
  source          String // signup | onboarding | reconsent | settings | import
  locale          String
  idempotencyKey  String
  createdAt       DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, documentType, purpose])
  @@index([documentType, documentVersion])
}

model CookiePreference {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion String
  categories    Json // { analytics: bool, marketing: bool }
  locale        String   @default("pt-BR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
